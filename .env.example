# ==============================================================================
# SustainIQ — Environment Configuration Template (.env.example)
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection URL
# Local development (default):
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/sustainiq
# Docker Compose:
# DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/sustainiq

# JWT Authentication Secret & Expiration
JWT_SECRET=your-secure-random-secret-key-at-least-32-characters-long
JWT_EXPIRES_IN=7d

# Redis Cache (Optional: automatic in-memory engine active if standalone Redis is offline)
REDIS_URL=redis://localhost:6379

# Client / Frontend URL for CORS & Cookie Authorization
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Frontend Vite Configuration
VITE_API_BASE_URL=http://localhost:5000/api
